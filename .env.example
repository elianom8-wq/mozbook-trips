# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Server-side only Google Maps Platform API key
# Used for Places API (New) nearby search and text search for Eateries & Social Check-In
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# PAYSUITE PRODUCTION CONFIGURATION (Server-Side Only - LIVE GATEWAY)
# Authoritative Base URL per official PaySuite specification:
PAYSUITE_BASE_URL="https://paysuite.tech"
# PaySuite secret API Bearer token retrieved from merchant dashboard:
# STRICT SECURITY: NEVER expose this token to the frontend client bundle or public repos.
PAYSUITE_API_TOKEN="MY_PAYSUITE_API_TOKEN"
# PaySuite webhook signing secret (HMAC-SHA256) for verifying X-Webhook-Signature:
PAYSUITE_WEBHOOK_SECRET="MY_PAYSUITE_WEBHOOK_SECRET"
